{
  "name": "talent-match",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "benchmark": "tsx scripts/benchmark.ts",
    "electron": "electron .",
    "build:win": "vite build && electron-builder --win",
    "build:win:portable": "vite build && electron-builder --win portable",
    "build:mac": "vite build && electron-builder --mac dmg"
  },
  "dependencies": {
    "lucide-react": "^0.294.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.talentmatch.ats",
    "productName": "TalentMatch ATS",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/favicon.svg"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
